# Dev database: Neon branch `dev`, database avanza_hrms_dev. Not the production database.
# Restricted app role avanza_hrms_app, pooled host. The Next.js app, jobs, and seed use this.
# `npm run db:roles` prints this value. Never put the owner role here.
DATABASE_URL="postgresql://avanza_hrms_app:PASSWORD@DEV-HOST-pooler.REGION.aws.neon.tech/avanza_hrms_dev?sslmode=require"

# Owner role avanza_hrms_owner, direct host (no -pooler), same dev database.
# Prisma migrate and `npm run db:roles` only.
DIRECT_URL="postgresql://avanza_hrms_owner:PASSWORD@DEV-HOST.REGION.aws.neon.tech/avanza_hrms_dev?sslmode=require"

# Direct host of the dev database above. npm test refuses to run against it.
DEV_DATABASE_HOST="DEV-HOST.REGION.aws.neon.tech"

# Test database for npm test: Neon branch `test`, database avanza_hrms_test. Never the dev database.
# Owner, direct host. Used by db:test:migrate, db:test:roles, db:test:reset, and test cleanup.
TEST_DIRECT_URL="postgresql://avanza_hrms_owner:PASSWORD@TEST-HOST.REGION.aws.neon.tech/avanza_hrms_test?sslmode=require"
# App role, pooled host. Printed by `npm run db:test:roles -- --rotate`.
TEST_DATABASE_URL="postgresql://avanza_hrms_app:PASSWORD@TEST-HOST-pooler.REGION.aws.neon.tech/avanza_hrms_test?sslmode=require"
# Direct host of the database Vercel uses (Neon branch `main`). npm test, npm run dev,
# and migration commands refuse to run against it unless NODE_ENV is production.
PRODUCTION_DATABASE_HOST="HOST.REGION.aws.neon.tech"

# Auth.js. Required for sign-in. Generate one with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Company email domain. Sign-in is rejected unless the address ends with @this value.
# There is no self-signup: a matching ACTIVE user must already exist.
AUTH_ALLOWED_EMAIL_DOMAIN="avanza.example"

# First Super Admin, created by `npm run db:seed` if that email does not exist yet.
# Re-running the seed does not change an existing user's roles.
AUTH_BOOTSTRAP_ADMIN_EMAIL="admin@avanza.example"
AUTH_BOOTSTRAP_ADMIN_NAME="Avanza Admin"

# Google Workspace SSO. Leave blank to hide the Google button.
# Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID SSO. Leave blank to hide the Microsoft button.
# Callback: http://localhost:3000/api/auth/callback/microsoft-entra-id
# Set the issuer to your tenant so personal Microsoft accounts cannot sign in.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Shared password form for local development only. Put the password in .env, never in
# .env.production or on Vercel. Production ignores both variables.
# Shown when NODE_ENV is not production, this is true, and AUTH_DEV_PASSWORD is set.
# Signs in an existing active user. It does not create accounts.
AUTH_DEV_LOGIN="true"
AUTH_DEV_PASSWORD=""

# Idle timeout in minutes. Admin roles (Super Admin, HR Admin) use the shorter value.
# Checked on each request. This is not a scheduled job.
AUTH_IDLE_TIMEOUT_MINUTES="480"
AUTH_ADMIN_IDLE_TIMEOUT_MINUTES="15"

# 32-byte key, base64-encoded. Encrypts bank details and government ID numbers at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMPLOYEE_DATA_KEY=""
