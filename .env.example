# App connection. Use the non-superuser role from `npm run db:up`.
# Superusers ignore GRANT/REVOKE, so they cannot be the app role.
DATABASE_URL="postgresql://avanza_app:avanza_app@127.0.0.1:5433/avanza_hrms?schema=public"

# Reserved for Auth.js. The app does not read these yet.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
